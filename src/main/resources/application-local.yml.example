# IDE에서 직접 실행할 때 사용하는 개인 설정 템플릿.
# 이 파일을 application-local.yml로 복사한 뒤 각자 환경에 맞게 값을 채운다.
# application-local.yml은 .gitignore 대상이므로 저장소에 올라가지 않는다.
#
# 실행: --spring.profiles.active=local
# DB는 컨테이너를 그대로 사용한다: docker compose up -d postgres

spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/sigme
    username: sigme
    password: 로컬-DB-비밀번호

  jpa:
    hibernate:
      ddl-auto: create-drop
    show-sql: true
    properties:
      hibernate:
        format_sql: true

server:
  # 컨테이너로 띄운 api가 쓰는 포트와 겹치지 않게 지정한다.
  port: 8082

logging:
  level:
    com.sigme.be: debug
